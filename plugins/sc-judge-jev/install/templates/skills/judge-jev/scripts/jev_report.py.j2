VERSION = "{{ version }}"
SKILL_DIR = pathlib.Path(__file__).resolve().parent.parent
TEMPLATES = SKILL_DIR / "templates"
REPORT_SCHEMA = "judge-jev/report/1"
UNSURE = 0.6         # an answer below it is unsure: the text leaves Jev undecided (references/fix-strategy.md)
DEFAULT_THRESHOLD = 0.6
ERROR_EXIT = 2
TIMEOUT = 120

Runner = Callable[[list, pathlib.Path], tuple]


def run_command(argv: list, cwd: pathlib.Path) -> tuple:
    """Run ``argv`` in ``cwd``; (exit code, stdout, stderr). A missing program is exit 127."""
    try:
        proc = subprocess.run(argv, cwd=str(cwd), capture_output=True, text=True, encoding="utf-8",
                              errors="replace", stdin=subprocess.DEVNULL, timeout=TIMEOUT, check=False)
    except FileNotFoundError as exc:
        return 127, "", str(exc)
    except subprocess.TimeoutExpired:
        return 124, "", f"{argv[0]} timed out after {TIMEOUT}s"
    return proc.returncode, proc.stdout, proc.stderr


def fail(code: str, message: str, action: str, data: Any = None) -> Err:
    error = JudgeError(code, message, action=action)
    error.data = data
    return Err(error)


# ---------------------------------------------------------------- inputs (pydantic, ADR-JEV-0005)


def _models():
    """The report's JSON inputs. Built on first use so ``--help`` needs no pydantic."""
    from pydantic import BaseModel, ConfigDict, Field, model_validator

    class Strict(BaseModel):
        model_config = ConfigDict(extra="forbid")

    class ReviewChange(Strict):
        change: str = Field(min_length=1, description="what changed, in a few words")
        why: str = Field(min_length=1, description="why it was kept or discarded")
        authority: str = Field("", description="the REQ, ADR, file and line it aligns with or drifts from")

    class Review(Strict):
        """The author's drift review of the run's original-to-final change (references/report.md)."""
        reviewed_at: str = Field(min_length=1)
        kept: list[ReviewChange] = []
        discarded: list[ReviewChange] = []

    class Answer(Strict):
        id: str
        text: str
        choice: str
        confidence: float = Field(ge=0.0, le=1.0)
        criterion: str

    class CheckRequest(Strict):
        variant: Optional[Literal["raw", "rendered"]] = None   # task mode: the raw template, then the rendered assignment
        request_id: str
        text: str = ""                                          # the location text this request sent
        verdict: Literal["yes", "no"]
        reason: list[Answer] = Field(min_length=1)

    class CheckPair(Strict):
        record_id: str
        record_kind: Literal["req", "adr", "nfr"]
        record_title: str = ""
        location: str = Field(min_length=1)                     # path, path#Heading, or path::Symbol
        mode: Literal["prompt", "skill", "task", "agent", "code"]
        requests: list[CheckRequest] = Field(min_length=1)

        @model_validator(mode="after")
        def _variants(self):
            variants = [r.variant for r in self.requests]
            if self.mode == "task" and variants != ["raw", "rendered"]:
                raise ValueError("task mode sends two requests, variant raw then rendered")
            if self.mode != "task" and variants != [None]:
                raise ValueError(f"{self.mode} mode sends one request, with no variant")
            return self

    class CheckResults(Strict):
        """What ``judge-jev check`` (one pair) or ``check --profile`` (every pair) will print as ``data``."""
        run: str = ""
        questions: str = ""                                     # the question set or its --questions override
        pairs: list[CheckPair] = Field(min_length=1)

    return Review, CheckResults


def _load(path: str, model, what: str) -> Result[Any, JudgeError]:
    try:
        raw = json.loads(pathlib.Path(path).read_text(encoding="utf-8"))
    except FileNotFoundError:
        return fail("SCRIPT.IO", f"{what} {path} does not exist", "Pass an existing file.")
    except (OSError, UnicodeError) as exc:
        return fail("SCRIPT.IO", f"{what} {path} could not be read: {type(exc).__name__}", "Make it a readable UTF-8 file.")
    except json.JSONDecodeError as exc:
        return fail("VALIDATION.INPUT", f"{what} {path} is not valid JSON: {exc.msg} (line {exc.lineno})", "Fix the file.")
    from pydantic import ValidationError
    try:
        return Ok(model.model_validate(raw))
    except ValidationError as exc:
        problems = "; ".join(f"{'.'.join(str(p) for p in e['loc']) or '(top)'}: {e['msg']}" for e in exc.errors()[:10])
        return fail("VALIDATION.INPUT", f"{what} {path} does not match its contract: {problems}",
                    "Fix the fields named; references/report.md gives the format.")


# ---------------------------------------------------------------- the Markdown diff


E = html.escape
HEADING_RE = re.compile(r"^(#{1,6})\s+(.*)$")
ITEM_RE = re.compile(r"^(\s*)(?:[-*+]|\d+[.)])\s+(.*)$")


def word_diff(a: str, b: str) -> str:
    """Escaped ``b`` with removed words in <del> and added words in <ins>."""
    x, y = re.findall(r"\S+|\s+", a or ""), re.findall(r"\S+|\s+", b or "")
    out = []
    for op, i1, i2, j1, j2 in difflib.SequenceMatcher(None, x, y, autojunk=False).get_opcodes():
        if op == "equal":
            out.append(E("".join(x[i1:i2])))
            continue
        if i2 > i1:
            out.append("<del>" + E("".join(x[i1:i2])) + "</del>")
        if j2 > j1:
            out.append("<ins>" + E("".join(y[j1:j2])) + "</ins>")
    return "".join(out)


def md_blocks(text: str) -> list:
    """A Markdown text's non-blank lines as (kind, level, content): ``h`` (level 1-6), ``li`` (level = indent),
    ``code`` (inside a fence, and the fences), ``row`` (a table row) or ``p``."""
    out, fence = [], False
    for line in (text or "").splitlines():
        if line.lstrip().startswith("```"):
            fence = not fence
            out.append(("code", 0, line))
        elif fence:
            out.append(("code", 0, line))
        elif not line.strip():
            continue
        elif re.fullmatch(r"\s*([-*_])(\s*\1){2,}\s*", line):
            out.append(("hr", 0, line.strip()))
        elif m := HEADING_RE.match(line):
            out.append(("h", len(m.group(1)), m.group(2)))
        elif m := ITEM_RE.match(line):
            out.append(("li", len(m.group(1)) // 2, m.group(2)))
        elif line.lstrip().startswith("|"):
            out.append(("row", 0, line.strip()))
        else:
            out.append(("p", 0, line.strip()))
    return out


INLINE = ((re.compile(r"`([^`<>]+)`"), r"<code>\1</code>"), (re.compile(r"\*\*([^*<>]+)\*\*"), r"<b>\1</b>"))


def _inline(fragment: str, kind: str) -> str:
    """Code spans and bold in an escaped fragment, where the markers do not straddle a <del>/<ins> tag."""
    if kind in ("code", "row"):
        return fragment
    for pattern, repl in INLINE:
        fragment = pattern.sub(repl, fragment)
    return fragment


def md_diff(before: str, after: str) -> dict:
    """The rendered document diff of two Markdown texts: every block of ``after`` in order, with removed blocks and
    words in <del> and added ones in <ins>. A block far from every change (and a heading whose section has none) has
    class ``far``: the page hides those in "Changes only" and shows them in "Whole document"."""
    a, b = md_blocks(before), md_blocks(after)
    rows = []  # (state, kind, level, html)
    sm = difflib.SequenceMatcher(None, a, b, autojunk=False)
    for op, i1, i2, j1, j2 in sm.get_opcodes():
        if op == "equal":
            rows += [("eq", k, lv, _inline(E(t), k)) for k, lv, t in b[j1:j2]]
        elif op == "replace" and i2 - i1 == j2 - j1 and all(p[0] == q[0] for p, q in zip(a[i1:i2], b[j1:j2])):
            rows += [("ch", q[0], q[1], _inline(word_diff(p[2], q[2]), q[0])) for p, q in zip(a[i1:i2], b[j1:j2])]
        else:
            rows += [("rm", k, lv, "<del>" + _inline(E(t), k) + "</del>") for k, lv, t in a[i1:i2]]
            rows += [("ad", k, lv, "<ins>" + _inline(E(t), k) + "</ins>") for k, lv, t in b[j1:j2]]
    changed = [i for i, r in enumerate(rows) if r[0] != "eq"]
    shown = {j for i in changed for j in (i - 1, i, i + 1) if 0 <= j < len(rows)}
    stack: list = []  # the headings above the current block: (level, row index)
    for i, (state, kind, level, _) in enumerate(rows):
        if kind == "h":
            stack = [h for h in stack if h[0] < level] + [(level, i)]
        if i in changed:
            shown.update(h[1] for h in stack)
    parts, hidden_before = [], False
    for i, (state, kind, level, body) in enumerate(rows):
        tag = f"h{min(level + 1, 6)}" if kind == "h" else "div"
        cls = ["md", f"md-{kind}", state] + ([f"lv{min(level, 3)}"] if kind == "li" else [])
        if i not in shown:
            cls.append("far")
        elif hidden_before:
            cls.append("gap")
        hidden_before = i not in shown
        parts.append(f'<{tag} class="{" ".join(cls)}">{body}</{tag}>')
    return {"html": "".join(parts), "changed": len(changed),
            "removed": sum(1 for r in rows if r[0] == "rm"), "added": sum(1 for r in rows if r[0] == "ad"),
            "edited": sum(1 for r in rows if r[0] == "ch")}


def record_section(text: Optional[str], record_id: str) -> Optional[str]:
    """The record's own section of a Markdown file: from the heading naming ``record_id`` to the next heading of the
    same or a higher level. The whole text when no heading names it."""
    if text is None:
        return None
    lines = text.splitlines()
    start = next((i for i, line in enumerate(lines) if HEADING_RE.match(line) and record_id in line), None)
    if start is None:
        return text
    level = len(HEADING_RE.match(lines[start]).group(1))
    end = next((i for i in range(start + 1, len(lines))
                if (m := HEADING_RE.match(lines[i])) and len(m.group(1)) <= level), len(lines))
    return "\n".join(lines[start:end])


# ---------------------------------------------------------------- one fix run (the workspace)


def dom_id(prefix: str, value: str) -> str:
    return prefix + "-" + re.sub(r"[^A-Za-z0-9._-]", "_", value)


def natural(text: str) -> list:
    return [int(p) if p.isdigit() else p for p in re.split(r"(\d+)", text)]


def _answer(reason: dict) -> dict:
    criterion = reason.get("criterion") or ""
    return {"question": reason.get("id"), "question_text": reason.get("text", ""), "choice": reason.get("choice"),
            "confidence": float(reason.get("confidence") or 0.0), "criterion": criterion, "failing": "Fix:" in criterion}


def _read_env(path: pathlib.Path) -> dict:
    out = {}
    for line in path.read_text(encoding="utf-8").splitlines():
        key, sep, value = line.partition("=")
        if sep and key.strip():
            out[key.strip()] = value.strip()
    return out


def parse_run(name: str, variant: str, n: int, envelope: Any, record_id: str) -> Result[dict, JudgeError]:
    """One run file (a ``quality`` envelope): its verdict, its units and its answers. A unit is what a rule fires on:
    one statement of a per-statement wave, or a whole record-level wave. ``fired`` lists the units whose wave said no."""
    run = {"name": name, "variant": variant, "n": n, "verdict": "error", "error": "", "units": {}, "answers": [],
           "log": None, "usage": None}
    if not isinstance(envelope, dict) or not envelope.get("success"):
        err = (envelope or {}).get("error") if isinstance(envelope, dict) else None
        run["error"] = f"{(err or {}).get('code', 'not an envelope')}: {(err or {}).get('message', '')}".strip()
        return Ok(run)
    try:
        (result,) = envelope["data"]["results"]
        rid = result["record"]["id"]
        if rid != record_id:
            return fail("VALIDATION.INPUT", f"{name}.json judged {rid}, not {record_id}",
                        "Keep one record per fix workspace (references/fix-strategy.md).")
        run["verdict"] = result["verdict"]
        log = envelope["data"].get("log")
        if isinstance(log, dict) and log.get("run") and log.get("log_root"):
            run["log"] = {"run": str(log["run"]), "log_root": str(log["log_root"])}
        for wave in result["waves"]:
            node = wave["node"]
            if wave.get("per") == "statement":
                fired = set(wave.get("matched_statements") or []) if wave["verdict"] == "no" else set()
                for entry in wave["reason"]:
                    st = entry["statement"]
                    key = f"{node} · s{st['index']}"
                    run["units"][key] = {"key": key, "node": node, "statement": st["index"], "text": st["text"],
                                         "modal": st.get("modal", ""), "fired": st["index"] in fired}
                    run["answers"] += [dict(_answer(a), unit=key) for a in entry["answers"]]
            else:
                key = f"{node} · record"
                run["units"][key] = {"key": key, "node": node, "statement": None, "text": "", "modal": "",
                                     "fired": wave["verdict"] == "no"}
                run["answers"] += [dict(_answer(a), unit=key) for a in wave["reason"]]
    except (KeyError, TypeError, ValueError) as exc:
        return fail("VALIDATION.INPUT", f"{name}.json is not a quality result ({type(exc).__name__}: {exc})",
                    "Pass the fix workspace whose <variant>-r<N>.json files hold the 'quality' output.")
    return Ok(run)


LOG_FILE = "logs/judge-jev.log.jsonl"


def _log_path(fix_dir: pathlib.Path, log_root: str) -> Optional[pathlib.Path]:
    """The judge-jev log a run wrote: ``log_root`` from the repository root (the working directory), else the
    ``.sc/judge-jev`` folder that holds ``fix/<ID>``."""
    root = pathlib.Path(log_root)
    for base in ([root] if root.is_absolute() else [pathlib.Path.cwd() / root, fix_dir.parent.parent]):
        if (base / LOG_FILE).is_file():
            return base / LOG_FILE
    return None


def _usage(path: pathlib.Path, names: set) -> dict:
    """Per run name: Jev requests and input and output tokens (each answer's raw_response usage), from the log events
    of that run. The log has no request start time (events are written after each answer), so it gives no latency. Each invocation ends with its ``verdict`` event; a run name logged by more than one
    invocation counts only its last."""
    segments: dict = {}
    with path.open(encoding="utf-8") as fh:
        for line in fh:
            try:
                e = json.loads(line)
                f = e["fields"]
            except (ValueError, KeyError, TypeError):
                continue
            if not isinstance(f, dict) or f.get("run") not in names:
                continue
            runs = segments.setdefault(f["run"], [[]])
            if not runs[-1] or runs[-1][-1].get("action") != "verdict" or e.get("action") == "verdict":
                runs[-1].append(e)
            else:
                runs.append([e])
    out = {}
    for name, runs in segments.items():
        last = runs[-1]
        answers = [e for e in last if e.get("action") == "answer"]
        usage = [((e["fields"].get("raw_response") or {}).get("usage") or {}) for e in answers]
        out[name] = {"requests": len(answers),
                     "input_tokens": sum(int(u.get("input_tokens") or 0) for u in usage),
                     "output_tokens": sum(int(u.get("output_tokens") or 0) for u in usage)}
    return out


def attach_usage(fix_dir: pathlib.Path, runs: list) -> Optional[str]:
    """Sets each run's ``usage`` from the judge-jev log; returns the log read, or None when no run's log is found."""
    logs: dict = {}
    for r in runs:
        if r["log"]:
            path = _log_path(fix_dir, r["log"]["log_root"])
            if path:
                logs.setdefault(path, set()).add(r["log"]["run"])
    found: dict = {}
    for path, names in logs.items():
        try:
            found.update(_usage(path, names))
        except (OSError, UnicodeError):
            continue
    for r in runs:
        if r["log"] and r["log"]["run"] in found:
            r["usage"] = found[r["log"]["run"]]
    return ", ".join(str(p) for p in logs) or None


def _tokens(n: int) -> str:
    return f"{n / 1000:.1f}k" if n >= 1000 else str(n)


def _cost(runs: list) -> Optional[dict]:
    """Requests and tokens summed over runs that have usage; None when none has."""
    us = [r["usage"] for r in runs if r["usage"]]
    if not us:
        return None
    total = {k: sum(u[k] for u in us) for k in ("requests", "input_tokens", "output_tokens")}
    return dict(total, runs=len(us), text=f"{_tokens(total['input_tokens'])} in / {_tokens(total['output_tokens'])} out")


RUN_FILE_RE = re.compile(r"^(?P<variant>[A-Za-z0-9_.]+)-r(?P<n>\d+)\.json$")


def _variant_order(name: str) -> tuple:
    return (0 if name == "base" else 2 if name == "final" else 1, natural(name))


def read_fix_dir(fix_dir: pathlib.Path) -> Result[dict, JudgeError]:
    """The fix workspace: env (ID, KIND, F), original.md, current.md, every ``<variant>-r<N>.json`` and ``<variant>.md``."""
    env_file = fix_dir / "env"
    if not env_file.is_file():
        return fail("REPORT.NO_RUNS", f"{fix_dir} is not a fix workspace: it has no env file",
                    "Pass the folder the fix loop wrote (.sc/judge-jev/fix/<ID>; references/fix-strategy.md step 1).")
    try:
        env = _read_env(env_file)
        texts = {p.stem: p.read_text(encoding="utf-8") for p in sorted(fix_dir.glob("*.md"))}
        files = sorted((p for p in fix_dir.glob("*.json") if RUN_FILE_RE.match(p.name)), key=lambda p: natural(p.name))
        raw = {p: p.read_text(encoding="utf-8") for p in files}
    except (OSError, UnicodeError) as exc:
        return fail("SCRIPT.IO", f"{fix_dir} could not be read: {type(exc).__name__}: {exc}", "Make the workspace readable.")
    record_id = env.get("ID", "")
    if not record_id:
        return fail("VALIDATION.INPUT", f"{env_file} names no ID", "Write the env file as fix-strategy.md step 1 does.")
    runs = []
    for p in files:
        m = RUN_FILE_RE.match(p.name)
        try:
            envelope = json.loads(raw[p]) if raw[p].strip() else None
        except json.JSONDecodeError:
            envelope = None
        got = parse_run(p.stem, m.group("variant"), int(m.group("n")), envelope, record_id)
        if isinstance(got, Err):
            return got
        runs.append(got.value)
    if not any(r["variant"] == "base" for r in runs):
        return fail("REPORT.NO_RUNS", f"{fix_dir} holds no base-r<N>.json: the loop has not judged the author's text",
                    "Run the loop's base step first (references/fix-strategy.md step 2).")
    variants = sorted({r["variant"] for r in runs}, key=_variant_order)
    log = attach_usage(fix_dir, runs)
    return Ok({"env": env, "record_id": record_id, "texts": texts, "runs": runs, "variants": variants, "log": log})


# ---------------------------------------------------------------- the quality model


def _f2(value: Optional[float]) -> str:
    return "-" if value is None else f"{value:.2f}"


def _tally(runs: list) -> str:
    """Passing runs over runs judged: ``0/3``; a run that errored is not judged and is counted apart."""
    judged = [r for r in runs if r["verdict"] in ("yes", "no")]
    yes = sum(1 for r in judged if r["verdict"] == "yes")
    errors = len(runs) - len(judged)
    return f"{yes}/{len(judged)}" + (f", {errors} error{'s' if errors > 1 else ''}" if errors else "")


def _status(runs: list) -> str:
    verdicts = {r["verdict"] for r in runs}
    return "pass" if verdicts == {"yes"} else "fail" if verdicts <= {"no", "error"} else "flaky"


def _fired(runs: list, key: str) -> int:
    return sum(1 for r in runs if r["units"].get(key, {}).get("fired"))


def _answers_for(runs: list, unit: str) -> dict:
    """{question: [answers, one per run]} of one unit."""
    out: dict = {}
    for r in runs:
        for a in r["answers"]:
            if a["unit"] == unit:
                out.setdefault(a["question"], []).append(dict(a, run=r["name"]))
    return out


def _common(answers: list, fix_first: bool = False) -> dict:
    """The most frequent choice among a question's answers (with ``fix_first``, among its Fix answers if it has any),
    with its mean confidence and a criterion it chose."""
    by_choice: dict = {}
    pool = [a for a in answers if a["failing"]] if fix_first and any(a["failing"] for a in answers) else answers
    for a in pool:
        by_choice.setdefault(a["choice"], []).append(a)
    choice, hits = max(by_choice.items(), key=lambda kv: (len(kv[1]), kv[0] or ""))
    return {"choice": choice, "count": len(hits), "of": len(answers),
            "confidence": _f2(sum(a["confidence"] for a in hits) / len(hits)), "criterion": hits[0]["criterion"],
            "failing": any(a["failing"] for a in hits)}


def _short(text: str, n: int = 90) -> str:
    text = " ".join((text or "").split())
    return text if len(text) <= n else text[: n - 1] + "…"


def quality_model(ws: dict, review: Optional[dict]) -> dict:
    runs, variants = ws["runs"], ws["variants"]
    by_variant = {v: [r for r in runs if r["variant"] == v] for v in variants}
    after_name = "final" if "final" in by_variant else variants[-1]
    base, after = by_variant["base"], by_variant[after_name]
    finished = after_name == "final"
    units: dict = {}
    for r in runs:
        for key, u in r["units"].items():
            units.setdefault(key, u)
    keys = sorted(units, key=natural)

    def unit_label(key: str) -> str:
        u = units[key]
        return f"s{u['statement']} · {_short(u['text'], 70)}" if u["statement"] is not None else f"{u['node']} (whole record)"

    def short_key(key: str) -> str:
        u = units[key]
        return f"s{u['statement']}" if u["statement"] is not None else u["node"]

    outcomes = []
    for key in keys:
        b, f = _fired(base, key), _fired(after, key)
        if not b and not f:
            continue
        # before: the base runs the rule fired in (they hold the answers that fired it); after: every last-step run
        before_q, after_q = _answers_for([r for r in base if r["units"].get(key, {}).get("fired")] or base, key), \
            _answers_for(after, key)
        why = []
        for q in sorted(set(before_q) | set(after_q), key=natural):
            bq = _common(before_q[q], fix_first=True) if q in before_q else None
            aq = _common(after_q[q]) if q in after_q else None
            if (bq and bq["failing"]) or (aq and aq["failing"]):
                why.append({"question": q, "before": bq, "after": aq})
        fixed_by = [v for v in variants[1:] if v != after_name and by_variant[v] and not _fired(by_variant[v], key)]
        outcomes.append({
            "key": key, "label": unit_label(key), "statement": units[key]["text"],
            "before": f"{b}/{len(base)}", "after": f"{f}/{len(after)}",
            "state": "fixed" if b and not f else "regressed" if f and not b else "still fails" if f >= b else "improved",
            "why": why, "fixed_by": ", ".join(fixed_by)})
    order = {"fixed": 0, "improved": 1, "still fails": 2, "regressed": 3}
    outcomes.sort(key=lambda o: (order[o["state"]], natural(o["key"])))

    # the chart: one tab per question; one row per unit; hollow dots = base runs, solid dots = the last step's runs,
    # light-gray dots = the steps between them (the candidates and their combination)
    mid_runs = [r for v in variants if v not in ("base", after_name) for r in by_variant[v]]
    groups: dict = {}
    rows = []
    for key in keys:
        before_q, after_q, mid_q = _answers_for(base, key), _answers_for(after, key), _answers_for(mid_runs, key)
        for q in sorted(set(before_q) | set(after_q), key=natural):
            sample = (before_q.get(q) or after_q.get(q))[0]
            g = groups.setdefault(q, {"id": q, "text": sample["question_text"], "fix_before": 0, "fix_after": 0})
            g["fix_before"] += sum(1 for a in before_q.get(q, []) if a["failing"])
            g["fix_after"] += sum(1 for a in after_q.get(q, []) if a["failing"])
            dots = [{"series": "before", "run": a["run"], "choice": a["choice"], "confidence": a["confidence"],
                     "failing": a["failing"], "criterion": a["criterion"]} for a in before_q.get(q, [])]
            dots += [{"series": "mid", "run": a["run"], "choice": a["choice"], "confidence": a["confidence"],
                      "failing": a["failing"], "criterion": a["criterion"]} for a in mid_q.get(q, [])]
            dots += [{"series": "after", "run": a["run"], "choice": a["choice"], "confidence": a["confidence"],
                      "failing": a["failing"], "criterion": a["criterion"]} for a in after_q.get(q, [])]
            rows.append({"group": q, "label": unit_label(key), "statement": units[key]["text"],
                         "question": sample["question_text"], "dots": dots})
    chart = {"threshold": UNSURE,
             "before": {"key": "before", "label": f"original text (base, {len(base)} runs)"},
             "after": {"key": "after", "label": f"fixed text ({after_name}, {len(after)} runs)"},
             "mid": {"key": "mid", "label": "steps between (" + ", ".join(v for v in variants if v not in ("base", after_name)) + ")"}
             if mid_runs else None,
             "groups": sorted(groups.values(), key=lambda g: natural(g["id"])), "rows": rows}

    steps = []
    for v in variants:
        rs = by_variant[v]
        fired = [k for k in keys if _fired(rs, k)]
        fixes = [o["key"] for o in outcomes if _fired(base, o["key"]) and not _fired(rs, o["key"])] if v != "base" else []
        steps.append({"step": v, "runs": len(rs), "tally": _tally(rs), "status": _status(rs),
                      "unsure": sum(1 for r in rs for a in r["answers"] if a["confidence"] < UNSURE),
                      "cost": _cost(rs),
                      "fired": ", ".join(short_key(k) for k in fired) or "-",
                      "clears": ", ".join(short_key(k) for k in fixes) or "-",
                      "errors": [f"{r['name']}: {r['error']}" for r in rs if r["verdict"] == "error"]})

    texts = ws["texts"]
    rid = ws["record_id"]
    original = record_section(texts.get("original"), rid)
    final_text = record_section(texts.get("current"), rid)
    doc = md_diff(original, final_text) if original is not None and final_text is not None else None
    candidates = [{"step": v, "dom": dom_id("cand", v), "diff": md_diff(original, record_section(texts[v], rid))}
                  for v in variants if v not in ("base", "final") and v in texts and original is not None]
    # confidence: every (statement, question) whose answer is below UNSURE in either step (lowest across its runs)
    def lowest(runs: list) -> dict:
        out: dict = {}
        for r in runs:
            for a in r["answers"]:
                k = (a["unit"], a["question"])
                if k not in out or a["confidence"] < out[k]["confidence"]:
                    out[k] = a
        return out

    low_b, low_a = lowest(base), lowest(after)
    unsure = []
    for k in sorted(set(low_b) | set(low_a), key=lambda k: (natural(k[0]), natural(k[1] or ""))):
        b, a = low_b.get(k), low_a.get(k)
        was, now = b is not None and b["confidence"] < UNSURE, a is not None and a["confidence"] < UNSURE
        if not (was or now):
            continue
        unsure.append({"key": f"{short_key(k[0])} · {k[1]}", "statement": units[k[0]]["text"],
                       "before": {"choice": b["choice"], "confidence": _f2(b["confidence"])} if b else None,
                       "after": {"choice": a["choice"], "confidence": _f2(a["confidence"])} if a else None,
                       "state": "still unsure" if was and now else "now confident" if was else "newly unsure"})
    unsure.sort(key=lambda u: ({"newly unsure": 0, "still unsure": 1, "now confident": 2}[u["state"]], natural(u["key"])))
    unsure_before = sum(1 for k, a in low_b.items() if a["confidence"] < UNSURE)
    unsure_after = sum(1 for k, a in low_a.items() if a["confidence"] < UNSURE)
    passed = finished and _status(after) == "pass"
    status = "fail" if not passed else "pass" if not unsure_after else "unsure"
    env = ws["env"]
    return {
        "id": ws["record_id"], "kind": env.get("KIND", "").upper(), "file": env.get("F", ""), "status": status,
        "finished": finished, "before_step": "base", "after_step": after_name,
        "before_tally": _tally(base), "after_tally": _tally(after),
        "before_status": _status(base), "after_status": _status(after),
        "fired_before": sum(1 for k in keys if _fired(base, k)), "fired_after": sum(1 for k in keys if _fired(after, k)),
        "fixed": sum(1 for o in outcomes if o["state"] == "fixed"),
        "regressed": sum(1 for o in outcomes if o["state"] == "regressed"),
        "unsure_before": unsure_before, "unsure_after": unsure_after, "unsure": unsure,
        "outcomes": outcomes, "steps": steps, "chart": chart, "doc": doc, "candidates": candidates,
        "cost": _cost(runs), "per_run": _cost([next(r for r in after if r["usage"])]) if any(r["usage"] for r in after) else None,
        "log": ws["log"],
        "review": review, "runs": [{"run": r["name"], "step": r["variant"], "verdict": r["verdict"], "error": r["error"],
                                    "unsure": sum(1 for a in r["answers"] if a["confidence"] < UNSURE),
                                    "cost": _cost([r])} for r in runs],
    }


def quality_context(m: dict) -> str:
    """Copy Context: the plain-text account of the run an agent pastes into its next step."""
    lines = [f"{m['id']} ({m['kind']}) fix run, runs passing: {m['before_step']} {m['before_tally']} -> "
             f"{m['after_step']} {m['after_tally']}"]
    if m["cost"]:
        lines.append(f"Jev cost: {m['cost']['requests']} requests, {m['cost']['text']} tokens")
    for o in m["outcomes"]:
        lines.append(f"{o['state'].upper()} {o['key']}: fired {o['before']} -> {o['after']}"
                     + (f" (cleared by {o['fixed_by']})" if o["fixed_by"] else ""))
        for w in o["why"]:
            b, a = w["before"], w["after"]
            lines.append(f"  {w['question']}: " + (f"{b['choice']} ({b['confidence']}) - {b['criterion']}" if b else "-")
                         + " => " + (f"{a['choice']} ({a['confidence']})" if a else "-"))
    lines += [f"{u['state'].upper()} {u['key']}: "
              + (f"{u['before']['choice']} ({u['before']['confidence']})" if u["before"] else "-") + " => "
              + (f"{u['after']['choice']} ({u['after']['confidence']})" if u["after"] else "-") for u in m["unsure"]]
    if m["review"]:
        lines += [f"Kept: {k['change']} - {k['why']}" for k in m["review"]["kept"]]
        lines += [f"Discarded: {k['change']} - {k['why']}" for k in m["review"]["discarded"]]
    return "\n".join(lines)


def _sidecar(m: dict) -> dict:
    """The model without HTML fragments (the sidecar and Copy JSON carry data, not markup)."""
    doc = {k: v for k, v in m["doc"].items() if k != "html"} if m["doc"] else None
    return dict(m, chart=None, doc=doc,
                candidates=[{"step": c["step"], **{k: v for k, v in c["diff"].items() if k != "html"}} for c in m["candidates"]])


def _title(fix_dir: pathlib.Path, record_id: str) -> str:
    """The record's title from the workspace's last Raptor snapshot, if any."""
    for name in ("index-final.json", "index-comb.json", "index-base.json"):
        try:
            data = json.loads((fix_dir / name).read_text(encoding="utf-8"))
        except (OSError, UnicodeError, ValueError):
            continue
        stack = [data]
        while stack:
            node = stack.pop()
            if isinstance(node, dict):
                if node.get("id") == record_id and isinstance(node.get("title"), str):
                    return node["title"]
                stack.extend(node.values())
            elif isinstance(node, list):
                stack.extend(node)
    return ""


OUTCOME_PILL = {"fixed": "pass", "improved": "flaky", "still fails": "fail", "regressed": "fail"}


def quality_panel_vars(m: dict) -> dict:
    return {
        "id": m["id"], "dom": m["dom"], "kind": m["kind"], "title": m["title"], "file": m["file"], "status": m["status"],
        "finished": m["finished"], "before_step": m["before_step"], "after_step": m["after_step"],
        "outcomes": [dict(o, pill=OUTCOME_PILL[o["state"]]) for o in m["outcomes"]], "steps": m["steps"],
        "unsure": m["unsure"],
        "doc_html": m["doc"]["html"] if m["doc"] else "", "doc_changed": m["doc"]["changed"] if m["doc"] else 0,
        "doc_stats": (f"Blocks: {m['doc']['edited']} edited, {m['doc']['added']} added, {m['doc']['removed']} removed"
                      if m["doc"] else ""),
        "candidates": [{"step": c["step"], "html": c["diff"]["html"], "changed": c["diff"]["changed"]}
                       for c in m["candidates"]],
        "chart_json": json.dumps(m["chart"], ensure_ascii=False, sort_keys=True),
        "reviewed": m["review"] is not None,
        "review_kept": (m["review"] or {}).get("kept", []), "review_discarded": (m["review"] or {}).get("discarded", []),
        "runs": m["runs"], "copy_json": _dump(_sidecar(m)), "context_text": quality_context(m),
    }


def build_quality(args, run: Runner = run_command) -> Result[dict, JudgeError]:
    review = None
    if args.review:
        Review, _ = _models()
        got = _load(args.review, Review, "review file")
        if isinstance(got, Err):
            return got
        review = got.value.model_dump()
    fix_dir = pathlib.Path(args.fix_dir)
    ws = read_fix_dir(fix_dir)
    if isinstance(ws, Err):
        return ws
    m = quality_model(ws.value, review)
    m["dom"], m["title"] = dom_id("record", m["id"]), _title(fix_dir, m["id"])
    status = m["status"].upper()
    shell = {
        "title": args.title or f"{m['id']} fix run",
        "subtitle": f"What the fix loop changed in {m['file'] or 'the record'} and why Jev's verdict moved "
                    f"from {m['before_step']} to {m['after_step']}.",
        "status": status,
        "tiles": [{"k": "Runs passing", "v": f"{m['before_tally']} → {m['after_tally']}",
                   "n": f"each run is one full judgement of the record; {m['before_step']} is the original text, "
                        f"{m['after_step']} the fixed text"},
                  {"k": "Failing statements", "v": f"{m['fired_before']} → {m['fired_after']}",
                   "n": "statements (or record-level waves) a rule fired on in any run"},
                  {"k": "Fixed", "v": str(m["fixed"]), "n": f"failed in {m['before_step']}, pass in every {m['after_step']} run"},
                  {"k": "Regressed", "v": str(m["regressed"]), "n": f"passed in {m['before_step']}, fail in {m['after_step']}"},
                  {"k": "Unsure answers", "v": f"{m['unsure_before']} → {m['unsure_after']}",
                   "n": f"answers below {UNSURE} confidence, which Jev may answer differently next time"},
                  {"k": "Jev input tokens", "v": _tokens(m["cost"]["input_tokens"]) if m["cost"] else "-",
                   "n": (f"{_tokens(m['cost']['output_tokens'])} out, {m['cost']['requests']} requests over "
                         f"{m['cost']['runs']} runs" + (f"; one {m['after_step']} run: {m['per_run']['requests']} requests, "
                                                        f"{m['per_run']['text']}" if m["per_run"] else ""))
                   if m["cost"] else "the judge-jev log of these runs was not found"}],
        "tables": [],
        "toc_rows": [{"id": f"{m['dom']}-{part}", "title": title} for part, title in
                     (("improved", "What improved and why"), ("unsure", "Unsure answers"), ("chart", "Confidence"),
                      ("steps", "Steps"),
                      ("text", "Text changes"), ("review", "Drift review"))],
        "metadata_rows": [{"label": "Fix workspace", "value": str(fix_dir)},
                          {"label": "Record file", "value": m["file"] or "-"},
                          {"label": "Steps", "value": ", ".join(s["step"] for s in m["steps"])},
                          {"label": "Drift review", "value": args.review or "-"},
                          {"label": "Unsure below", "value": f"{UNSURE} confidence"},
                          {"label": "Tokens from", "value": m["log"] or "- (log not found)"}],
        "summary_copy_json": "", "summary_copy_context": "",
    }
    model = {"schema": REPORT_SCHEMA, "mode": "quality", "generated_at": _now(), "status": status,
             "fix_dir": str(fix_dir), "record": _sidecar(m)}
    written = write_report(args, "quality", [m], "quality-record-panel.xhtml.j2", quality_panel_vars, shell, model, run)
    if isinstance(written, Err):
        return written
    return Ok(dict(written.value, record=m["id"], before=m["before_tally"], after=m["after_tally"], fixed=m["fixed"],
                   regressed=m["regressed"], still_failing=m["fired_after"], unsure_before=m["unsure_before"],
                   unsure_after=m["unsure_after"]))


# ---------------------------------------------------------------- rendering


def find_sc_compose() -> Result[str, JudgeError]:
    binary = shutil.which("sc-compose")
    if binary is None:
        return fail("DEPENDENCY.SC_COMPOSE", "sc-compose is not on PATH; the report is rendered with it",
                    "Install sc-compose 1.7.0 or newer and put it on PATH (references/installation-and-troubleshooting.md).")
    return Ok(binary)


def render(binary: str, template: str, variables: dict, out: pathlib.Path, scratch: pathlib.Path,
           run: Runner) -> Result[str, JudgeError]:
    """One strict, render-checked sc-compose render of templates/<template> into ``out``; its text."""
    var_file = scratch / (out.name + ".vars.json")
    var_file.write_text(json.dumps(variables, ensure_ascii=False), encoding="utf-8")
    code, _, errout = run([binary, "render", "--root", str(TEMPLATES), "--file", str(TEMPLATES / template),
                           "--var-file", str(var_file), "--strict", "--check-render", "--output", str(out)],
                          scratch)  # sc-compose keeps its log in the working folder: the scratch folder, never the skill
    if code != 0:
        return fail("RENDER.FAILED", f"sc-compose could not render {template} (exit {code}): {errout.strip()[-1500:]}",
                    "Fix the template or the variables named above; rerun.")
    try:
        return Ok(out.read_text(encoding="utf-8"))
    except (OSError, UnicodeError) as exc:
        return fail("SCRIPT.IO", f"{out} could not be read back: {type(exc).__name__}", "Check the --out folder.")


def _dump(value: Any) -> str:
    return json.dumps(value, indent=2, sort_keys=True, ensure_ascii=False)


def write_report(args, kind: str, units: list, panel_template: str, panel_vars: Callable, shell: dict, model: dict,
                 run: Runner) -> Result[dict, JudgeError]:
    """Render every panel, then the page around them; write the sidecar. ``shell`` holds the page's own variables."""
    binary = find_sc_compose()
    if isinstance(binary, Err):
        return binary
    out = pathlib.Path(args.out).resolve()  # sc-compose runs in a scratch folder
    panels_dir = out / args.name
    try:
        panels_dir.mkdir(parents=True, exist_ok=True)
    except OSError as exc:
        return fail("SCRIPT.IO", f"could not create {panels_dir}: {exc}", "Pass a writable --out folder.")
    sections, panel_paths = [], []
    with tempfile.TemporaryDirectory(prefix="jev-report-") as tmp:
        scratch = pathlib.Path(tmp)
        for u in units:
            path = panels_dir / f"{u['dom']}.xhtml"
            got = render(binary.value, panel_template, panel_vars(u), path, scratch, run)
            if isinstance(got, Err):
                return got
            sections.append(got.value)
            panel_paths.append(path.as_posix())
        page = out / f"{args.name}.html"
        generated = model["generated_at"]
        got = render(binary.value, "report.html.j2", dict(shell, sections=sections, generated_at=generated,
                                                          kind=kind, version=VERSION), page, scratch, run)
        if isinstance(got, Err):
            return got
    sidecar = out / f"{args.name}.json"
    try:
        sidecar.write_text(_dump(model) + "\n", encoding="utf-8")
    except OSError as exc:
        return fail("SCRIPT.IO", f"could not write {sidecar}: {exc}", "Pass a writable --out folder.")
    return Ok({"html": page.as_posix(), "sidecar": sidecar.as_posix(), "panels": panel_paths, "status": shell["status"],
               "units": len(units)})


def _now() -> str:
    return datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


# ---------------------------------------------------------------- check (the contract; no check command yet)


def check_unit(location: str, pairs: list) -> dict:
    """One location's panel model: every record judged at it, each request's answers, and the dot chart."""
    mode = pairs[0]["mode"]
    records, rows, groups = [], [], {}
    for p in pairs:
        verdict = "yes" if all(r["verdict"] == "yes" for r in p["requests"]) else "no"
        requests = []
        for r in p["requests"]:
            name = r["variant"] or "request"
            requests.append({"variant": name, "request_id": r["request_id"], "verdict": r["verdict"], "text": r["text"],
                             "answers": [dict(_answer(a), confidence=_f2(a["confidence"])) for a in r["reason"]]})
        for a in p["requests"][0]["reason"]:
            dots = []
            for r in p["requests"]:
                hit = next((x for x in r["reason"] if x["id"] == a["id"]), None)
                if hit is not None:
                    dots.append({"series": "before" if r["variant"] == "raw" else "after", "run": r["request_id"],
                                 "choice": hit["choice"], "confidence": hit["confidence"],
                                 "failing": "Fix:" in hit["criterion"], "criterion": hit["criterion"]})
            g = groups.setdefault(a["id"], {"id": a["id"], "text": a["text"], "fix_before": 0, "fix_after": 0})
            g["fix_before"] += sum(1 for d in dots if d["series"] == "before" and d["failing"])
            g["fix_after"] += sum(1 for d in dots if d["series"] == "after" and d["failing"])
            rows.append({"group": a["id"], "label": p["record_id"], "question": a["text"], "statement": "", "dots": dots})
        records.append({"id": p["record_id"], "kind": p["record_kind"].upper(), "title": p["record_title"],
                        "verdict": verdict, "status": "pass" if verdict == "yes" else "fail", "requests": requests})
    status = "pass" if all(r["verdict"] == "yes" for r in records) else "fail"
    return {"id": location, "dom": dom_id("location", location), "mode": mode,
            "target_class": "code" if mode == "code" else "agent text", "status": status, "records": records,
            "chart": {"threshold": UNSURE,
                      "before": {"key": "before", "label": "raw template"} if mode == "task" else None,
                      "after": {"key": "after", "label": "rendered assignment" if mode == "task" else "request"},
                      "groups": sorted(groups.values(), key=lambda g: natural(g["id"])), "rows": rows}}


def check_panel_vars(u: dict) -> dict:
    context = [f"{u['id']} ({u['mode']}): {u['status'].upper()}"]
    for r in u["records"]:
        context.append(f"  {r['id']}: {r['verdict']}")
        context += [f"    {q['variant']} {a['question']} = {a['choice']} ({a['confidence']}) - {a['criterion']}"
                    for q in r["requests"] for a in q["answers"] if a["failing"]]
    return {"id": u["id"], "dom": u["dom"], "mode": u["mode"], "target_class": u["target_class"], "status": u["status"],
            "records": u["records"], "chart_json": json.dumps(u["chart"], ensure_ascii=False, sort_keys=True),
            "copy_json": _dump(dict(u, chart=None)), "context_text": "\n".join(context)}


def build_check(args, run: Runner = run_command) -> Result[dict, JudgeError]:
    _, CheckResults = _models()
    got = _load(args.results, CheckResults, "check results")
    if isinstance(got, Err):
        return got
    results = got.value.model_dump()
    by_location: dict = {}
    for p in results["pairs"]:
        by_location.setdefault(p["location"], []).append(p)
    units = [check_unit(loc, by_location[loc]) for loc in sorted(by_location, key=natural)]
    per_record: dict = {}
    for u in units:
        for r in u["records"]:
            per_record.setdefault(r["id"], {"kind": r["kind"], "title": r["title"], "met": [], "failed": []})
            per_record[r["id"]]["met" if r["verdict"] == "yes" else "failed"].append(u)
    record_rows = [{"dom": dom_id("rec", rid), "cells": [
        {"text": rid, "mono": True}, {"text": v["kind"]}, {"text": v["title"]},
        {"text": "met everywhere" if not v["failed"] else f"fails {len(v['failed'])}/{len(v['met']) + len(v['failed'])}",
         "pill": "pass" if not v["failed"] else "fail"},
        {"text": ", ".join(u["id"] for u in v["failed"]) or "-", "small": True}]}
        for rid, v in sorted(per_record.items(), key=lambda kv: natural(kv[0]))]
    location_rows = [{"dom": u["dom"], "cells": [
        {"text": u["id"], "href": "#" + u["dom"], "mono": True}, {"text": u["mode"]}, {"text": u["target_class"]},
        {"text": "pass" if u["status"] == "pass" else "fail", "pill": u["status"]},
        {"text": ", ".join(r["id"] for r in u["records"] if r["verdict"] == "yes") or "-", "small": True},
        {"text": ", ".join(r["id"] for r in u["records"] if r["verdict"] != "yes") or "-", "small": True}]} for u in units]
    pairs = len(results["pairs"])
    met = sum(1 for u in units for r in u["records"] if r["verdict"] == "yes")
    status = "PASS" if met == pairs else "FAIL"
    classes = sorted({u["target_class"] for u in units})
    shell = {
        "title": args.title or "judge-jev check report",
        "subtitle": f"Does each location meet the records that govern it? Target class: {', '.join(classes)}.",
        "status": status,
        "tiles": [{"k": "Pairs", "v": str(pairs), "n": "(record, location) judged"},
                  {"k": "Met", "v": f"{met}/{pairs}", "n": "every request of the pair yes"},
                  {"k": "Locations", "v": str(len(units)), "n": f"{sum(1 for u in units if u['status'] == 'pass')} meet all"},
                  {"k": "Records", "v": str(len(per_record)),
                   "n": f"{sum(1 for v in per_record.values() if not v['failed'])} met everywhere"}],
        "tables": [{"title": "Per record", "id": "per-record",
                    "note": "Met at every listed location, or the locations that fail it.",
                    "columns": ["Record", "Kind", "Title", "Result", "Failing locations"], "rows": record_rows},
                   {"title": "Per location", "id": "per-location", "note": "The records each location meets and fails.",
                    "columns": ["Location", "Mode", "Class", "Result", "Meets", "Fails"], "rows": location_rows}],
        "toc_rows": [{"id": u["dom"], "title": u["id"], "status": u["status"]} for u in units],
        "metadata_rows": [{"label": "Results file", "value": args.results},
                          {"label": "Run", "value": results["run"] or "-"},
                          {"label": "Question set", "value": results["questions"] or "shipped"}],
        "summary_copy_json": _dump({rid: {"met": [u["id"] for u in v["met"]], "failed": [u["id"] for u in v["failed"]]}
                                    for rid, v in per_record.items()}),
        "summary_copy_context": "\n".join(f"{u['id']}: {u['status'].upper()}" for u in units),
    }
    model = {"schema": REPORT_SCHEMA, "mode": "check", "generated_at": _now(), "status": status,
             "results": results, "locations": [dict(u, chart=None) for u in units]}
    written = write_report(args, "check", units, "check-location-panel.xhtml.j2", check_panel_vars, shell, model, run)
    if isinstance(written, Err):
        return written
    return Ok(dict(written.value, pairs=pairs, met=met))


# ---------------------------------------------------------------- CLI


class _UsageError(Exception):
    pass


class _JsonArgumentParser(argparse.ArgumentParser):
    def error(self, message):  # argparse hook; never returns
        raise _UsageError(f"{self.prog}: {message}")


def _parser() -> argparse.ArgumentParser:
    p = _JsonArgumentParser(prog="jev_report.py", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = p.add_subparsers(dest="command", required=True, parser_class=_JsonArgumentParser)
    q = sub.add_parser("quality", help="one fix run: what improved from base to final, and why")
    q.add_argument("--fix-dir", required=True, help="the run's fix workspace, .sc/judge-jev/fix/<ID>")
    q.add_argument("--review", default="", help="the author's drift review JSON (references/report.md)")
    q.set_defaults(func=build_quality)
    c = sub.add_parser("check", help="each location against the records that govern it")
    c.add_argument("--results", required=True, help="check results JSON (CheckResults, references/report.md)")
    c.set_defaults(func=build_check)
    for s in (q, c):
        s.add_argument("--out", required=True, help="output folder")
        s.add_argument("--name", default="", help="file stem of the page, sidecar and panel folder (default: the mode)")
        s.add_argument("--title", default="")
    return p


def _print(envelope: dict) -> None:
    print(json.dumps(envelope, indent=2, sort_keys=True, ensure_ascii=False))


def main(argv: Optional[list] = None, run: Runner = run_command) -> int:
    try:
        args = _parser().parse_args(argv)
    except _UsageError as exc:
        _print(JudgeError("VALIDATION.INPUT", str(exc), action="Run 'jev_report.py --help' for the accepted arguments.").to_json())
        return ERROR_EXIT
    args.name = args.name or f"{args.command}-report"
    try:
        outcome = args.func(args, run)
    except Exception as exc:  # noqa: BLE001 - a bug, not an expected failure: a JSON error beats a traceback
        _print(JudgeError("SCRIPT.INTERNAL", f"{type(exc).__name__}: {exc}",
                          action="Report this with the command line that produced it.").to_json())
        return ERROR_EXIT
    if isinstance(outcome, Err):
        _print(outcome.error.to_json())
        return ERROR_EXIT
    _print({"success": True, "data": outcome.value, "error": None})
    return 0


if __name__ == "__main__":
    sys.exit(run_main(main))
