---
name: python-best-practices-assignment
version: 0.1.0
description: Render a fenced-JSON assignment for python-best-practices-agent.
format: json
required_variables:
  - review_mode
  - worktree_path
  - branch
  - commit
  - review_targets
optional_variables:
  - practice_mode
  - practice_ids
  - round_limit
  - changed_files
  - carry_forward_findings_json
  - notes
defaults:
  practice_mode: ""
  practice_ids: []
  round_limit: false
  changed_files: []
  carry_forward_findings_json: "[]"
  notes: ""
---
{
  "review_mode": {{ review_mode }},
  "worktree_path": {{ worktree_path }},
  "branch": {{ branch }},
  "commit": {{ commit }},
  "review_targets": [{% for target in review_targets %}{{ target }}{% if not loop.last %}, {% endif %}{% endfor %}],
  "practice_mode": {% if practice_mode %}{{ practice_mode }}{% elif review_mode == "phase_end" %}"all"{% else %}"selected"{% endif %},
  "practice_ids": {% if practice_ids and practice_mode != "all" %}
    [{% for practice_id in practice_ids %}{{ practice_id }}{% if not loop.last %}, {% endif %}{% endfor %}]
  {% elif not practice_mode and review_mode == "sprint_review" %}
    ["PBP-001", "PBP-003", "PBP-004"]
  {% elif not practice_mode and review_mode == "doc_review" %}
    ["PBP-001", "PBP-002", "PBP-003", "PBP-006"]
  {% else %}
    []
  {% endif %},
  "round_limit": {% if round_limit %}true{% else %}false{% endif %},
  "changed_files": [{% for file in changed_files %}{{ file }}{% if not loop.last %}, {% endif %}{% endfor %}],
  "carry_forward_findings": {{ carry_forward_findings_json | safe }},
  "findings_scope_locked": {% if carry_forward_findings_json != "[]" %}true{% else %}false{% endif %},
  "notes": {{ notes ~ (" SCOPE LOCK: this is a fix-round verification dispatch. Report a disposition (fixed | open | regressed) for each id in carry_forward_findings ONLY. Put anything else observed under `notes`, not `findings`." if carry_forward_findings_json != "[]" else "") }}
}
